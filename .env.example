# Harness proxy environment. Copy to .env for local dev; set the same keys in
# Vercel project env for deploys. NEVER commit real values.
#
# Server-side OpenRouter key. Required for /api/chat and /api/models.
OPENROUTER_API_KEY=
# Shared secret the client presents as `Authorization: Bearer <token>`.
# Required for any non-loopback deploy (a deploy without it fails closed).
HARNESS_ACCESS_TOKEN=
